{
  "name": "meinsert",
  "version": "1.3.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Insert and edit file metadata locally in your browser.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build:css": "node scripts/build-css.mjs",
    "check:css": "node scripts/build-css.mjs --check",
    "build:policies": "node scripts/build-policies.mjs",
    "check:policies": "node scripts/build-policies.mjs --check",
    "lint": "eslint assets/js sw.js scripts tests",
    "serve": "python3 -m http.server 8000",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:undo": "node tests/e2e/single-undo-redo.mjs",
    "test:undo:batch": "node tests/e2e/batch-undo-redo.mjs",
    "test:security": "node tests/e2e/security.mjs",
    "test:engine": "node tests/e2e/engine-loading.mjs",
    "test:quick-save": "node tests/e2e/quick-save.mjs",
    "test:clean": "node tests/e2e/clean-metadata.mjs",
    "test:clean:batch": "node tests/e2e/batch-clean.mjs",
    "test:policy": "node tests/e2e/policy-notice.mjs",
    "test:office": "node tests/e2e/office.mjs",
    "test:about": "node tests/e2e/about.mjs",
    "test:offline": "node tests/e2e/offline-settings.mjs",
    "test:reveal": "node tests/e2e/scroll-reveal.mjs",
    "test:preview": "node tests/e2e/preview-animation.mjs",
    "test:action-bar": "node tests/e2e/action-bar.mjs",
    "test:e2e:all": "node tests/e2e/run-all.mjs",
    "test:fast": "npm run test && npm run lint && npm run check:css && npm run check:policies",
    "test:i18n": "node tests/e2e/i18n.mjs",
    "test:compat": "node tests/compat/run.mjs",
    "fixtures:generate": "node tests/fixtures/generate.mjs"
  },
  "devDependencies": {
    "@colorhythm/exiftool-wasm": "1.0.5",
    "@eslint/js": "^9.39.5",
    "browser-id3-writer": "6.4.0",
    "eslint": "^9.39.5",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "mediabunny": "1.65.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.62.1"
  }
}
