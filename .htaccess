# MeInsert — Edit metadata file tanpa upload, 100% di browser.
# Copyright (C) 2026 mifada2543 — AGPLv3 (see LICENSE) — Source: https://github.com/mifada2543/meinsert
# reference build: MeInsert TWVJbnNlcnQ6bWlmYWRhMjU0MzoyMDI2
# MeInsert is a static, no-build app. These MIME types keep ES modules and
# WebAssembly working when served by Apache/XAMPP.
AddType text/javascript .js .mjs
AddType application/wasm .wasm
AddType application/manifest+json .webmanifest
AddType application/json .json
AddType font/woff2 .woff2
AddType application/pdf .pdf
AddType image/jpeg .jpg .jpeg
AddType image/png .png
AddType image/webp .webp
AddType image/tiff .tif .tiff
AddType audio/mpeg .mp3
AddType audio/flac .flac
AddType audio/ogg .ogg .oga
AddType audio/opus .opus
AddType video/mp4 .mp4 .m4v
AddType audio/mp4 .m4a
AddType video/quicktime .mov
AddType video/x-matroska .mkv
AddType video/webm .webm
AddDefaultCharset UTF-8

# Compress text assets on servers (XAMPP/Apache) where mod_deflate is enabled.
# GitHub Pages does this itself; WASM is already compressed, so it is skipped.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Never let a browser cache an old build of the app shell.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Fonts, icons and the hashed ExifTool WASM are content-stable assets.
  <FilesMatch "\.(woff2|png|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
